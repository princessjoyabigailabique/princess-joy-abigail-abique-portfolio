# ---- Public (safe to expose; used in browser) ----
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Your real Calendly event URL, e.g. https://calendly.com/your-username/discovery-call
NEXT_PUBLIC_CALENDLY_URL=
# Public profile links (defaults are also defined in src/data/site.ts)
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/princessjoyabigailabique/
NEXT_PUBLIC_EMAIL_ADDRESS=abique.princessjoy@gmail.com
NEXT_PUBLIC_VIBER_URL=
NEXT_PUBLIC_ONLINEJOBS_URL=https://www.onlinejobs.ph/jobseekers/info/1271476
NEXT_PUBLIC_TRYHACKME_URL=https://tryhackme.com/p/Pr1Nc3ssJ0y
# Optional Cloudflare Turnstile site key (public)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ----
# Contact form delivery via Resend (https://resend.com)
RESEND_API_KEY=
# Where inquiries are delivered (your inbox)
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Portfolio <contact@your-verified-domain.com>"
CONTACT_FROM_EMAIL=
# Optional Cloudflare Turnstile secret key (server-side anti-spam)
TURNSTILE_SECRET_KEY=

# ---- Credentials visibility ----
# Draft credentials (all of them, until you verify each) are HIDDEN in production builds.
# Set to "true" only for a private Preview deployment where you want to review drafts.
# NEXT_PUBLIC_SHOW_DRAFT_CREDENTIALS=false
